# Server Configuration
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Google Cloud Platform Configuration
# Required for Vertex AI integration and E2E tests
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-east5
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# Default Model Configuration
# Use the correct Vertex AI model name
DEFAULT_MODEL=claude-sonnet-4-5@20250929

# Embedding Provider Configuration
DEFAULT_EMBEDDING_PROVIDER=vertex

# OpenAI Provider (optional)
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Provider (optional)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Model Storage
MODEL_CACHE_DIR=./models

# Custom Embedding Provider Example
# EMBEDDING_PROVIDER_CUSTOM_TYPE=huggingface
# EMBEDDING_PROVIDER_CUSTOM_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER_CUSTOM_API_KEY=optional_key

# Additional Vertex AI Models (if needed)
# EMBEDDING_PROVIDER_VERTEX2_TYPE=vertex
# EMBEDDING_PROVIDER_VERTEX2_MODEL=text-embedding-preview-0815