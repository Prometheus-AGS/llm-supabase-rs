# Docker Environment Configuration for LLM Supabase RS
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
RUST_LOG=info

# =============================================================================
# VERTEX AI CONFIGURATION (Required)
# =============================================================================
# Your Google Cloud Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCP Region (default: us-east5)
GCP_LOCATION=us-east5

# Path to your GCP service account credentials JSON file
# This should be mounted as a volume in docker-compose.yaml
GCP_CREDENTIALS_PATH=./gcp-credentials.json

# Default model to use
DEFAULT_MODEL=claude-sonnet-4-5@20250929

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (private - keep secure)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret for token validation
SUPABASE_JWT_SECRET=your-jwt-secret

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# Directory for model caching
MODEL_CACHE_DIR=/app/data/models

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Set to true in production
PRODUCTION=true

# Domain for CORS (optional)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting (requests per minute)
RATE_LIMIT=100

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================
# Enable metrics collection
METRICS_ENABLED=true

# Enable distributed tracing
TRACING_ENABLED=true

# Log requests (be careful with sensitive data)
LOG_REQUESTS=false